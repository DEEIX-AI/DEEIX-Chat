{
  "name": "@deeix/web",
  "version": "0.4.1",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/sync-assets.mjs",
    "sync:version": "node ../scripts/sync-version.mjs frontend",
    "check:version": "node ../scripts/sync-version.mjs --check frontend",
    "sync:icons": "node scripts/sync-lobehub-icons.mjs",
    "sync:screenshot-worker": "node scripts/sync-screenshot-worker.mjs",
    "sync:pwa-assets": "node scripts/sync-pwa-assets.mjs",
    "sync:assets": "node scripts/sync-assets.mjs",
    "predev": "node ../scripts/sync-version.mjs --check frontend && node scripts/sync-assets.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node ../scripts/sync-version.mjs --check frontend && node scripts/sync-assets.mjs",
    "build": "next build --turbopack",
    "analyze": "next experimental-analyze",
    "analyze:output": "next experimental-analyze --output",
    "start": "next start",
    "typecheck": "tsc --noEmit --pretty false",
    "check": "pnpm lint && pnpm typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "clean": "rm -rf .next out"
  },
