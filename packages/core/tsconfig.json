{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    // Deliberately no "DOM" lib and no ambient types: `window`, `document`,
    // `localStorage`, `process` etc. must fail to typecheck here.
    // Platform I/O is injected by the host app. Tests use tsconfig.test.json.
    "lib": ["ES2022"],
    "types": [],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
