# Copy to deploy/secrets/desktop-signing.env (git-ignored) and fill in.
# The same inputs go into GitHub Secrets for CI (APPLE_CERTIFICATE there is
# the base64 of the .p12; locally point at the file instead).

# Updater signature (all platforms).
TAURI_SIGNING_PRIVATE_KEY_PATH=deploy/secrets/deeix-chat-updater.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# macOS: Developer ID Application certificate (.p12) and notarization account.
# Signing identity and team id are read from the certificate.
APPLE_CERTIFICATE_PATH=deploy/secrets/apple.p12
APPLE_CERTIFICATE_PASSWORD=
APPLE_ID=
APPLE_PASSWORD=

# Windows: code-signing certificate (.pfx). Optional until you have one.
WINDOWS_CERTIFICATE_PATH=
WINDOWS_CERTIFICATE_PASSWORD=
